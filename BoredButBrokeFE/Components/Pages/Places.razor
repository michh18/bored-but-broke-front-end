    private void ApplyFilters()
    {
        // int.TryParse(Budget, out var budgetValue);

        // FilteredPlaces = AllPlaces
        //     .Where(p =>
        //         (string.IsNullOrWhiteSpace(Location) || p.Location.City.Contains(Location, StringComparison.OrdinalIgnoreCase))
        //         || (p.Price == (Price)budgetValue)
        //     )
        //     .ToList();
        var selectedPrices = new List<Price>();

        if (CheapSelected)
            selectedPrices.Add(Price.Cheap);

        if (ModerateSelected)
            selectedPrices.Add(Price.Moderate);

        if (ExpensiveSelected)
            selectedPrices.Add(Price.Expensive);

        if (VeryExpensiveSelected)
            selectedPrices.Add(Price.VeryExpensive);

        FilteredPlaces = AllPlaces
            .Where(p =>
                selectedPrices.Count == 0 ||
                selectedPrices.Contains(p.Price))
            .ToList();
    }
