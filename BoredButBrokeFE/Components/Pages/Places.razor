@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory

@page "/places"

@using BoredButBrokeFE.Components.Models
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory
@rendermode InteractiveServer

<PageTitle>Places</PageTitle>

@if (IsError)
{
    <div class="places-error-page">
        <div class="places-error-wrapper">

            <div class="places-error-illustration">
                <div class="places-error-bubble"></div>

                <div class="places-error-browser">
                    <div class="places-error-browser-bar">
                        <span class="places-error-browser-dot"></span>
                        <span class="places-error-browser-dot"></span>
                        <span class="places-error-browser-dot"></span>
                    </div>

                    <div class="places-error-browser-face">
                        <div class="places-error-browser-eyes">
                            <div class="places-error-browser-eye"></div>
                            <div class="places-error-browser-eye"></div>
                        </div>

                        <div class="places-error-browser-mouth"></div>
                    </div>
                </div>

                <div class="places-error-browser-shadow"></div>
            </div>

            <h1 class="places-error-title">
                Oops!
            </h1>

            <p class="places-error-text">
                @(string.IsNullOrWhiteSpace(Error.Detail)
                            ? "We couldn't load places right now."
                            : Error.Detail)
        </p>

            <button class="places-error-button" @onclick="RefreshPage">
                Try Again
            </button>

        </div>
    </div>
}
else if (IsLoading)
{
    <p>Finding places for you...</p>
}
else
{
    <div class="places-results-page">
        <div class="filter-column">
            <h3 class="filter-title">Filters</h3>

            <div class="filter-section">
                <h4>Categories</h4>
                @foreach (var category in VisibleCategories)
                {
                    <label class="filter-option">
                        <input type="checkbox"
                                checked="@selectedCategories.Contains(category)"
                                @onchange="() => ToggleCategory(category)" />
                        <span>@category</span>
                    </label>
                }
                @if (AvailableCategories.Count > CategoryPreviewCount)
                {
                    <button type="button" class="view-more-btn" @onclick="ToggleShowAllCategories">
                        @(ShowAllCategories ? "View less" : $"View {AvailableCategories.Count - CategoryPreviewCount} more...")
                    </button>
                }
            </div>

            <div class="filter-section">
                <h4>Price</h4>

                @foreach (var price in AvailablePrices)
                {
                    <label class="filter-option">
                        <input type="checkbox" checked="@selectedPrices.Contains(price)" @onchange="() => TogglePrice(price)" />
                        <span>@PriceLabel(price)</span>
                    </label>
                }
            </div>
        </div>

        <div class="places-results">
            <h1>Found Results</h1>
            <PlaceSummaryList Places="FilteredPlaces"/>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string Location { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string SelectedDate { get; set; }

    [SupplyParameterFromQuery] 
    public string StartTime { get; set; }

    [SupplyParameterFromQuery]
    public string EndTime { get; set; }

    [SupplyParameterFromQuery]
    public string AgeRange { get; set; }

    [SupplyParameterFromQuery]
    public string Budget { get; set; }

    [SupplyParameterFromQuery]
    public string Categories { get; set; } 

    [SupplyParameterFromQuery]
    public int Radius { get; set; } = 8047;

    private HashSet<Price> selectedPrices { get; set; } = new();

    private List<Price> AvailablePrices => AllPlaces
        .Select(p => p.Price)
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    private void TogglePrice(Price price)
    {
        if (selectedPrices.Contains(price))
            selectedPrices.Remove(price);
        else
            selectedPrices.Add(price);

        ApplyFilters();
    }

    private static string PriceLabel(Price price) => price switch
    {
        Price.Cheap => "Cheap (£)",
        Price.Moderate => "Moderate (££)",
        Price.Expensive => "Expensive (£££)",
        Price.VeryExpensive => "Very Expensive (££££)",
        _ => price.ToString()
    };

    private List<Place> AllPlaces { get; set; } = new();
    private List<Place> FilteredPlaces { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool IsError { get; set; } = false;
    private ErrorResponse Error { get; set; } = new();

    private List<string> AvailableCategories =>
        AllPlaces.SelectMany(p => p.Categories)
                    .Select(c => c.Title)
                    .Distinct()
                    .ToList();

    private HashSet<string> selectedCategories { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var queryParams = new Dictionary<string, string>();

        if (!string.IsNullOrWhiteSpace(Location))
            queryParams["location"] = Location;
        if (Radius > 0)
            queryParams["radius"] = Radius.ToString();
        if (!string.IsNullOrWhiteSpace(Categories))
            queryParams["categories"] = Categories;
        if (!string.IsNullOrWhiteSpace(SelectedDate))
            queryParams["date"] = SelectedDate;
        if (!string.IsNullOrWhiteSpace(StartTime))
            queryParams["startTime"] = StartTime;
        if (!string.IsNullOrWhiteSpace(EndTime))
            queryParams["endTime"] = EndTime;
        if (!string.IsNullOrWhiteSpace(AgeRange))
            queryParams["ageRange"] = AgeRange;
        if (!string.IsNullOrWhiteSpace(Budget))
            queryParams["budget"] = Budget;

        var queryString = string.Join("&", queryParams.Select(kv =>
            $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

        var Http = HttpClientFactory.CreateClient("BBBBackEnd");
        var response = await Http.GetAsync($"api/places?{queryString}");
        var responseBody = await response.Content.ReadAsStringAsync();

        if (response.IsSuccessStatusCode)
        {
            AllPlaces = JsonSerializer.Deserialize<List<Place>>(responseBody)
                   ?? new List<Place>();
        }
        else
        {
            Error = JsonSerializer.Deserialize<ErrorResponse>(responseBody) ?? new();
            IsError = true;
        }

        ApplyFilters();
        IsLoading = false;
    }

    private const int CategoryPreviewCount = 5;
    private bool ShowAllCategories { get; set; } = false;

    private List<string> VisibleCategories =>
        ShowAllCategories
            ? AvailableCategories
            : AvailableCategories.Take(CategoryPreviewCount).ToList();
    
    private void ToggleCategory(string category)
    {
        if (selectedCategories.Contains(category))
            selectedCategories.Remove(category);
        else
            selectedCategories.Add(category);

        ApplyFilters();
    }
    private void ToggleShowAllCategories()
    {
        ShowAllCategories = !ShowAllCategories;
    }

    private void ApplyFilters()
    {

        FilteredPlaces = AllPlaces
            .Where(p => (selectedPrices.Count == 0 || selectedPrices.Contains(p.Price)) &&
                (selectedCategories.Count == 0 || p.Categories.Any(c => selectedCategories.Contains(c.Title))))
            .ToList();
    }
    private void RefreshPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}