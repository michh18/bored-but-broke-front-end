@page "/places/{PlaceId}"

@using BoredButBrokeFE.Components.Models
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

@if (_error)
{
    <p>Could not load place. Please try again.</p>
}
else if (place is null)
{
    <p>Loading...</p>
}
else
{
    <div class="place-details-page">
        <button class="back-button" @onclick="GoBack">
            <span class="back-arrow">←</span>
            <span>Back</span>
        </button>
        <div class="place-img">
            
            <img src="@place.ImageUrl" alt="@place.PlaceName" />
        </div>
        <div class="place-content">
            <div class="place-header">
                <div class="place-title-section">
                    <h1>@place.PlaceName</h1>

                    <p class="place-location">
                        📍@string.Join(", ", place.Location.DisplayAddress)
                    </p>
                </div>
                
                <div class="place-meta">
                    <div class="meta-pill">⭐ @place.Rating</div>
                    <div class="meta-pill">@GetPriceDisplay()</div>
                </div>
            </div>

            <div class="places-category-and-opening-hours">
                <div class="place-section">
                    <h2>Categories</h2>

                    <div class="category-list">
                        @foreach (var category in place.Categories)
                        {
                            <div class="category-tag">@category.Title</div>
                        }
                    </div>
                </div>

                <div class="place-section">
                    <h2>Opening Hours</h2>

                    <div class="hours-list">
                        @foreach (var openingHours in place.OpeningHours)
                        {
                            @foreach (var hour in openingHours.Hours)
                            {
                                <div class="hour-row">
                                    <span>@GetDayName(hour.Day)</span>
                                    <span>@FormatTime(hour.Start) - @FormatTime(hour.End)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <a class="place-link" href="@place.PlaceUrl" target="_blank">
                Visit Website
            </a>

        </div>
    </div>
}

@code {
    [Parameter]
    public string PlaceId { get; set; } = string.Empty;
    private Place? place;

    private bool _error = false;

    private string GetPriceDisplay()
    {
        return place?.Price switch
        {
            Price.Cheap => "£",
            Price.Moderate => "££",
            Price.Expensive => "£££",
            Price.VeryExpensive => "££££",
            _ => ""
        };
    }

    private string GetDayName(int day)
    {
        return day switch
        {
            0 => "Monday",
            1 => "Tuesday",
            2 => "Wednesday",
            3 => "Thursday",
            4 => "Friday",
            5 => "Saturday",
            6 => "Sunday",
            _ => ""
        };
    }

    private string FormatTime(string time)
    {
        if (string.IsNullOrWhiteSpace(time) || time.Length != 4)
        {
            return time;
        }
        return $"{time[0..2]}:{time[2..4]}";
    }

    protected override async Task OnInitializedAsync()
    {
        var Http = HttpClientFactory.CreateClient("BBBBackEnd");
        try
        {
            place = await Http.GetFromJsonAsync<Place>($"api/places/{PlaceId}");
        }
        catch
        {
            _error = true;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}