            Price.Moderate => "££",
            Price.Expensive => "£££",
            Price.VeryExpensive => "££££",
            _ => ""
        };
    }

    private string GetDayName(int day)
    {
        return day switch
        {
            0 => "Monday",
            1 => "Tuesday",
            2 => "Wednesday",
            3 => "Thursday",
            4 => "Friday",
            5 => "Saturday",
            6 => "Sunday",
            _ => ""
        };
    }

    private string FormatTime(string time)
    {
        if (string.IsNullOrWhiteSpace(time) || time.Length != 4)
        {
            return time;
        }
        return $"{time[0..2]}:{time[2..4]}";
    }

