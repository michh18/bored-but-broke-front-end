@page "/"

<PageTitle>Bored But Broke</PageTitle>

<div class="home-form-wrapper">
    <h1>Bored But Broke?</h1>
    <p class="tagline">Tell us a bit about yourself and we will plan your perfect day out.</p>

    <div class="plan-form">
        <div class="form-question">
            <label for="location">Enter your location</label>
            <input type="text" id="location" placeholder="e.g. Manchester" class="form-input" />
        </div>

        <div class="form-question">
            <label for="date">Date</label>
            <input type="date" id="date" class="form-input" />
        </div>

        <div class="form-question">
            <label for="age-range">Select an age range</label>
            <select id="age-range" class="form-input">
                <option value="" disabled selected>Choose an option</option>
                <option value="under-18">Under 18</option>
                <option value="18-30">18 to 30</option>
                <option value="30-49">30 to 49</option>
                <option value="50+">50+</option>
                <option value="family">Family with children</option>
            </select>
        </div>

        <div class="form-question">
            <label for="budget">Select your budget</label>
            <select id="budget" class="form-input">
                <option value="" disabled selected>Choose a budget</option>
                <option value="1">£</option>
                <option value="2">££</option>
                <option value="3">£££</option>
                <option value="4">££££</option>
            </select>
        </div>

        <button class="btn-submit">Search</button>
    </div>
</div>
