</div>

@code {
    private string Location { get; set; } = string.Empty;
    private DateTime? SelectedDate { get; set; }
    private string TimeOut { get; set; } = "09:00";
    private string TimeHome { get; set; } = "17:00";
    private string AgeRange { get; set; } = string.Empty;
    private string Budget { get; set; } = string.Empty;

    private void HandleSearch()
    {
        Console.WriteLine($"Location: {Location}");
        Console.WriteLine($"Date: {SelectedDate}");
        Console.WriteLine($"From: {TimeOut}, Until: {TimeHome}");
        Console.WriteLine($"Age Range: {AgeRange}, Budget: {Budget}");
    }
}
